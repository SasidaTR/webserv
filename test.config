server {
    server_name webserv_test;
    host 127.0.0.1;
    port 8080;
    root ./html;
    index index.html;
    methods GET POST DELETE;
    client_max_body_size 10MB;

    # Location racine
    location / {
        root ./html;
        index index.html;
        autoindex off;
        methods GET POST;
    }

    # Location avec autoindex activé (directory listing)
    location /files {
        root ./html;
        autoindex on;
        methods GET POST DELETE;
        upload_dir ./html/files;
    }

    # Location CGI pour Python et Bash
    location /cgi-bin {
        root ./cgi;
        index test.py;
        autoindex on;
        methods GET POST;
        cgi_path /usr/bin/python3 /bin/bash;
        cgi_ext .py .sh;
    }

    # Location avec redirection
    location /redirect {
        return 301 /files;
    }

    # Location avec redirection externe
    location /google {
        redirect 302 https://www.google.com;
    }

    # Location media avec autoindex
    location /media {
        root ./html;
        autoindex on;
        methods GET;
    }
}

server {
    server_name webserv_secondary;
    host 0.0.0.0;
    port 8080;
    root ./html;
    index index.html;
    methods GET;
    
    location / {
        root ./html;
        autoindex on;
    }
}
