server {
    server_name webserv_test;
    host 127.0.0.1;
    port 8080;
    root ./YoupiBanane;
    index index.html;
    methods GET;
	
    location / {
        methods GET;
    }

	location /put_test {
        alias ./YoupiBanane;
        upload_dir ../;
        methods PUT;
    }

	location /cgi-bin {
        root ./YoupiBanane;
        cgi_path /bin/bash;
        cgi_ext .sh;
    }

	location /post_body {
        methods POST;
        client_max_body_size 100;
    }

    location /directory {
        methods GET POST HEAD;
        alias ./YoupiBanane;
        index youpi.bad_extension;
        autoindex off;
    }
}
