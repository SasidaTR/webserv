server {
    server_name webserv;
    host 127.0.0.1;
    port 8080;
    root ./YoupiBanane;
    index index.html;
    methods GET POST DELETE;
    client_max_body_size 5MB;

    location / {
        index index.html;
        autoindex off;
        methods GET;
    }

    location /put_test/* {
        root ./html;
        autoindex off;
        upload_dir ../../;
        methods PUT;
    }

    location /post_body {
        methods POST;
        client_max_body_size 100;
    }

    location /directory {
        methods GET;
        root ./YoupiBanane;
        index youpi.bad_extension;
        autoindex off;
    }

    location /cgi-bin {
        root ./cgi;
        index script.py;
        autoindex off;
        methods POST;
        cgi_path /usr/bin;
        cgi_ext .bla;
    }
}