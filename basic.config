server {
    server_name webserv;
    host 0.0.0.0;
    port 8080;
    root ./html;
    index index.html;

    location / {
        root ./html;
        index index.html;
        autoindex off;
    }

    location /files {
        root ./data;
        autoindex off;
    }

    location /cgi-bin {
        root ./cgi;
        index script.py;
        autoindex off;
        cgi_path /usr/bin/python3 /bin/bash;
        cgi_ext .py .sh;
    }
}