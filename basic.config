server {
    port 8080;
	server_name localhost;
    host 0.0.0.0;
    root ./html;
	index index.html;
    error_page 404.html;

    location / {
        allow_methods  DELETE POST GET;
        autoindex off;
    }
    
    location /test {
        autoindex on;
        index test.html;
        allow_methods GET POST PUT;
    }

    location /cgi-bin {
        root ./;
        allow_methods GET POST DELETE;
        index time.py;
        cgi_path /usr/bin/python3 /bin/bash;
        cgi_ext .py .sh;
    }
}